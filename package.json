{
  "name": "roomkit",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @roomkit/shared build && pnpm --filter server start:dev",
    "dev:shared": "pnpm --filter @roomkit/shared dev",
    "test:e2e": "pnpm --filter server test:e2e"
  }
}
