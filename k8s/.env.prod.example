# Copy to k8s/.env.prod and fill in real values.
# deploy.sh loads this file into the roomkit-secrets k8s secret.

POSTGRES_PASSWORD=change-me
# At least 16 characters.
JWT_SECRET=change-me-change-me
ADMIN_ID=admin
# bcrypt hash of the admin password (e.g. node -e "console.log(require('bcrypt').hashSync('...', 10))")
ADMIN_PASSWORD_HASH=change-me
# Doubles as the MinIO root user/password.
S3_ACCESS_KEY_ID=roomkit
S3_SECRET_ACCESS_KEY=change-me
