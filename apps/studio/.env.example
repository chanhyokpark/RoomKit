# Base URL of the RoomKit server (no trailing slash, without /api)
PUBLIC_API_URL=http://localhost:3000

# Minimum component versions the operation / website-test screens warn below.
# Optional — defaults come from EXPECTED_VERSIONS in @roomkit/shared. Read at
# runtime (adapter-node), so they can be set on the deployment without a rebuild.
#PUBLIC_EXPECTED_PLAYER_VERSION=0.8.0
#PUBLIC_EXPECTED_CLIENT_VERSION=0.3.0
#PUBLIC_EXPECTED_HELPER_VERSION=0.3.0
