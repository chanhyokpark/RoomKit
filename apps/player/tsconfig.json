{
	"compilerOptions": {
		"target": "ES2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vite/client"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"@roomkit/shared": ["../../packages/shared/src/index.ts"],
			"@roomkit/client": ["../../packages/client/src/index.ts"],
			"@roomkit/session-ui": ["../../packages/session-ui/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
