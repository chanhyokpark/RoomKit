generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  timeLimitMs Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets   Asset[]
  tags     Tag[]
  sessions Session[]
}

// Enum values match the lowercase AssetKind in @roomkit/shared verbatim,
// so no mapping layer is needed at the API boundary.
enum AssetKind {
  device
  bgm
  dialogue
  sfx
  video
  image
  file
  hint
  player
  website
  message
  phase
  event
}

model Asset {
  id          String    @id @default(uuid())
  themeId     String
  theme       Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  kind        AssetKind
  name        String
  description String    @default("")
  // device (user-set) and hint (auto 4-digit) only; NULLs don't collide in the unique index
  code        String?
  // Per-kind payload, zod-validated against @roomkit/shared schemas at the API boundary
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]

  @@unique([themeId, kind, code])
  @@index([themeId, kind])
}

model Tag {
  id      String  @id @default(uuid())
  themeId String
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  name    String
  color   String
  assets  Asset[]

  @@unique([themeId, name])
}

// Phases and events are assets (kind = phase / event); their payloads live in
// Asset.data like every other kind.

// Enum values match the lowercase shared schemas verbatim (like AssetKind).
enum SessionMode {
  test
  production
}

enum SessionState {
  created
  running
  paused
  ended
}

enum LogLevel {
  info
  warn
  error
}

enum Verdict {
  success
  fail
}

model Session {
  id      String       @id @default(uuid())
  themeId String
  theme   Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  mode    SessionMode
  state   SessionState @default(created)
  // Asset id (kind = phase). No FK: asset deletion must not cascade into live sessions.
  phaseId String?
  vars    Json         @default("{}")
  // Game outcome recorded by the endTheme command; null until it runs.
  verdict Verdict?

  // Creation time until the session starts; updated to the actual start time.
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  // Exactly one of these is set while a timer exists: timerEndsAt while
  // running, timerRemainingMs while paused.
  timerEndsAt      DateTime?
  timerRemainingMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceCodes SessionDeviceCode[]
  logs        SessionLog[]

  // A partial unique index (hand-written in the migration) additionally
  // enforces one non-ended production session per theme.
  @@index([themeId, state])
}

model SessionDeviceCode {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Asset id (kind = device); no FK for the same reason as Session.phaseId.
  deviceId  String
  // Operator-entered; globally unique so the /device handshake can look up by
  // code alone. Rows are deleted when the session ends, freeing the codes.
  code      String  @unique

  @@unique([sessionId, deviceId])
}

model SessionLog {
  id        Int      @id @default(autoincrement())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  level     LogLevel
  kind      String
  message   String
  data      Json?

  @@index([sessionId, id])
}
