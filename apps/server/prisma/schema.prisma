generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  timeLimitMs Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]
  tags   Tag[]
}

// Enum values match the lowercase AssetKind in @roomkit/shared verbatim,
// so no mapping layer is needed at the API boundary.
enum AssetKind {
  device
  bgm
  dialogue
  sfx
  video
  hint
  player
  website
  message
  phase
  event
}

model Asset {
  id          String    @id @default(uuid())
  themeId     String
  theme       Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  kind        AssetKind
  name        String
  description String    @default("")
  // device (user-set) and hint (auto 4-digit) only; NULLs don't collide in the unique index
  code        String?
  // Per-kind payload, zod-validated against @roomkit/shared schemas at the API boundary
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]

  @@unique([themeId, kind, code])
  @@index([themeId, kind])
}

model Tag {
  id      String  @id @default(uuid())
  themeId String
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  name    String
  color   String
  assets  Asset[]

  @@unique([themeId, name])
}

// Phases and events are assets (kind = phase / event); their payloads live in
// Asset.data like every other kind.
