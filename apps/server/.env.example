# Copy to .env and adjust. Matches the root docker-compose.yml defaults.
PORT=3000
DATABASE_URL=postgresql://roomkit:roomkit@localhost:5433/roomkit

JWT_SECRET=change-me-to-a-long-random-string

ADMIN_ID=admin
# Generate with (inside apps/server):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'yourpassword'
ADMIN_PASSWORD_HASH=

S3_ENDPOINT=http://localhost:9000
# Endpoint browsers/devices use for presigned URLs; defaults to S3_ENDPOINT.
# Only needed when the server reaches MinIO via a different host than clients
# do (e.g. in docker-compose: S3_ENDPOINT=http://minio:9000, public below).
#S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=roomkit
S3_ACCESS_KEY_ID=roomkit
S3_SECRET_ACCESS_KEY=roomkit123
S3_FORCE_PATH_STYLE=true

# Externally reachable server origin — used to build hosted-website URLs for
# the "navigate device to website" command. Defaults to http://localhost:PORT.
#PUBLIC_SERVER_URL=https://roomkit.example.com
